# ---- Auth proxy (mcp-auth-proxy.js) ----
# REQUIRED: the public HTTPS origin clients reach you at (no trailing slash).
MCP_PUBLIC_BASE=https://my-machine.my-tailnet.ts.net

# Where the proxy listens (put Tailscale Funnel / your reverse proxy in front of it).
MCP_PROXY_HOST=127.0.0.1
MCP_PROXY_PORT=8000

# Where the HTTP bridge listens (must match MCP_BRIDGE_HOST/PORT below).
MCP_UPSTREAM_HOST=127.0.0.1
MCP_UPSTREAM_PORT=8001

# Directory for secret/state files (.oauth-*, .mcp-token). Defaults to the repo root.
# MCP_DATA_DIR=

# Name shown on the consent page. Defaults to the machine hostname.
# MCP_SERVER_LABEL=

# Secrets. Leave unset to use (or auto-generate) the dot-files in MCP_DATA_DIR.
# MCP_AUTH_TOKEN=        # optional static bearer token (legacy fallback)
# MCP_OAUTH_SIGNING_KEY= # HS256 key for access tokens
# MCP_OAUTH_PIN=         # PIN you type on the consent page

# ---- HTTP bridge (http-bridge/bridge.js) ----
MCP_BRIDGE_HOST=127.0.0.1
MCP_BRIDGE_PORT=8001

# Defaults: the current node binary + ./dc-wrapper.js
# MCP_STDIO_COMMAND=
# MCP_STDIO_WRAPPER=

# ---- dc-wrapper.js ----
# Path to a globally installed desktop-commander binary. Defaults to the pinned local dependency.
# DESKTOP_COMMANDER_BIN=
