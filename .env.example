# Optional shell environment for the Titian CLI (not automatically loaded).
# Default: .titian/ at the repository root.
# TITIAN_DATA_DIR=/absolute/path/to/private-state

# Override the discovered Node.js executable.
# MCP_NODE_BIN=/absolute/path/to/node

# Usually persisted by: titian init --origin https://your-host.example
# MCP_PUBLIC_BASE=https://your-host.example
