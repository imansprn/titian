{
  "name": "titian",
  "version": "1.0.0",
  "description": "Manage independent desktop MCP projects behind one authenticated gateway.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci",
    "test": "node --test tests/*.test.js tests/bridge/*.test.mjs",
    "test:manager": "python3 tests/test_bootstrap.py && python3 tests/test_failures.py && python3 tests/test_permissions.py",
    "test:dependencies": "node tests/dependencies.cjs",
    "test:permissions-runtime": "node --test tests/runtime-permissions.smoke.mjs"
  },
  "bin": {
    "titian": "bin/titian"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@wonderwhy-er/desktop-commander": "0.2.51"
  },
  "overrides": {
    "md-to-pdf": {
      "chokidar": "^4.0.3"
    },
    "sharp": "^0.35.4",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
